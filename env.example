# Database Configuration
POSTGRES_DB=billing_app
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/billing_app
SPRING_DATASOURCE_USERNAME=user1
SPRING_DATASOURCE_PASSWORD=asroma

# Server Configuration
SERVER_PORT=8087
SERVER_SERVLET_CONTEXT_PATH=/api/v1.0

# Browser → API (localhost on server; for LAN set real IP — see switch-network.sh)
VITE_API_BASE_URL=http://localhost:8087/api/v1.0
BACKEND_URL=http://localhost:8087
SERVER_IP=127.0.0.1

# CORS (include every UI origin that will call the API)
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# JWT Configuration
JWT_SECRET_KEY=thisismysecretkeyfortheupcomingproject

# AWS S3 (optional)
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key
AWS_REGION=eu-central-1
AWS_BUCKET_NAME=your_bucket_name

# Payments / card terminal
RAZORPAY_KEY_ID=disabled
RAZORPAY_KEY_SECRET=disabled
CARD_TERMINAL_SIMULATE=true
CARD_TERMINAL_TIMEOUT=30000
CARD_TERMINAL_DEFAULT_ID=TERMINAL_001
CARD_TERMINAL_MERCHANT_ID=DEMO_MERCHANT

# Fiscal device
FISCAL_DEVICE_MAIN_SERIAL=TEST123456789
FISCAL_DEVICE_MAIN_NAME=Glavno_fiskalno_ustrojstvo
